{
  "name": "polipetto-claude",
  "displayName": "Polipetto per Claude Code",
  "description": "%description%",
  "version": "0.5.1",
  "publisher": "aebwp",
  "license": "MIT",
  "pricing": "Free",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1F2428",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AEBWP/polipetto-claude.git"
  },
  "homepage": "https://github.com/AEBWP/polipetto-claude#readme",
  "bugs": {
    "url": "https://github.com/AEBWP/polipetto-claude/issues"
  },
  "keywords": [
    "claude",
    "claude code",
    "mascot",
    "pet",
    "pixel art"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "l10n": "./l10n",
  "main": "./src/extension.js",
  "scripts": {
    "test": "node --test",
    "package": "npx --yes @vscode/vsce package"
  },
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "polipetto.view",
          "name": "Claude Worker"
        }
      ]
    },
    "configuration": {
      "title": "Polipetto",
      "properties": {
        "polipetto.scope": {
          "type": "string",
          "enum": [
            "all",
            "workspace"
          ],
          "enumDescriptions": [
            "%config.scope.all%",
            "%config.scope.workspace%"
          ],
          "default": "all",
          "description": "%config.scope.description%"
        }
      }
    }
  }
}
