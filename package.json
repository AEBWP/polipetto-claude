{
  "name": "polipetto-claude",
  "displayName": "Polipetto per Claude Code",
  "description": "%description%",
  "version": "0.6.0",
  "publisher": "aebwp",
  "license": "MIT",
  "pricing": "Free",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1F2428",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AEBWP/polipetto-claude.git"
  },
  "homepage": "https://github.com/AEBWP/polipetto-claude#readme",
  "bugs": {
    "url": "https://github.com/AEBWP/polipetto-claude/issues"
  },
  "keywords": [
    "claude",
    "claude code",
    "mascot",
    "pet",
    "pixel art"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "l10n": "./l10n",
  "main": "./src/extension.js",
  "scripts": {
    "test": "node --test",
    "package": "npx --yes @vscode/vsce package"
  },
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "polipetto.view",
          "name": "Claude Worker",
          "contextualTitle": "Claude Worker",
          "when": "config.polipetto.showInExplorer"
        }
      ],
      "scm": [
        {
          "type": "webview",
          "id": "polipetto.view.scm",
          "name": "Claude Worker",
          "contextualTitle": "Claude Worker",
          "when": "config.polipetto.showInSourceControl"
        }
      ],
      "debug": [
        {
          "type": "webview",
          "id": "polipetto.view.debug",
          "name": "Claude Worker",
          "contextualTitle": "Claude Worker",
          "when": "config.polipetto.showInRunAndDebug"
        }
      ],
      "test": [
        {
          "type": "webview",
          "id": "polipetto.view.test",
          "name": "Claude Worker",
          "contextualTitle": "Claude Worker",
          "when": "config.polipetto.showInTesting"
        }
      ]
    },
    "configuration": {
      "title": "Polipetto",
      "properties": {
        "polipetto.scope": {
          "type": "string",
          "enum": [
            "all",
            "workspace"
          ],
          "enumDescriptions": [
            "%config.scope.all%",
            "%config.scope.workspace%"
          ],
          "default": "all",
          "description": "%config.scope.description%"
        },
        "polipetto.showInExplorer": {
          "type": "boolean",
          "default": true,
          "description": "%config.showInExplorer%"
        },
        "polipetto.showInSourceControl": {
          "type": "boolean",
          "default": true,
          "description": "%config.showInSourceControl%"
        },
        "polipetto.showInRunAndDebug": {
          "type": "boolean",
          "default": false,
          "description": "%config.showInRunAndDebug%"
        },
        "polipetto.showInTesting": {
          "type": "boolean",
          "default": false,
          "description": "%config.showInTesting%"
        }
      }
    }
  }
}
